nextflow_pipeline {

    name "Test WGS PBSV workflow"
    script "../main.nf"
    profile "test_wgs_pbsv"
    tag "pipeline"
    tag "pbsv"

    test("Run PBMM2 and PBSV") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def succeeded_tasks = workflow.trace.succeeded()*.name
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def vcf_files = getAllFilesFromDir(params.outdir, include: [
                'pbsv/*.sv.vcf.gz',
            ])

            assertAll(
                { assert workflow.success },
                { assert succeeded_tasks.any { task_name -> task_name.contains('PBMM2_ALIGN') } },
                { assert succeeded_tasks.any { task_name -> task_name.contains('PBSV_DISCOVER') } },
                { assert succeeded_tasks.any { task_name -> task_name.contains('PBSV_CALL') } },
                { assert succeeded_tasks.every { task_name -> !task_name.contains('HIPHASE') } },
                { assert succeeded_tasks.every { task_name -> !task_name.contains('DEEPVARIANT_RUNDEEPVARIANT') } },
                { assert succeeded_tasks.every { task_name -> !task_name.contains('SAWFISH') } },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_pacvar_software_mqc_versions.yml"),
                    stable_path,
                    stable_content,
                    vcf_files.collect { file -> [file.getName(), path(file.toString()).vcf.variants.size()] }
                ).match() }
            )
        }
    }
}
