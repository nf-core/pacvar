/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing pbsv variant caller
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and parameters for a lightweight PBMM2-pbsv test

    Use as follows:
        nextflow run nf-core/pacvar -r 1.2.0<or above> -profile test_wgs_pbsv,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]

    withName: 'PBMM2_ALIGN' {
        memory = '15 GB'
        cpus = 4
    }
}

params {
    config_profile_name         = 'Test profile'
    config_profile_description  = 'Minimal test dataset to check pipeline function for wgs workflow with pbsv'

    input                       = params.pipelines_testdata_base_path + 'pacbio_data/samplesheet-fiberseq-with-m6A-tags.csv'
    fasta                       = params.pipelines_testdata_base_path + 'pacbio_data/GRCh38_revio_m6a_intervals.fasta'
    fasta_fai                   = params.pipelines_testdata_base_path + 'pacbio_data/GRCh38_revio_m6a_intervals.fasta.fai'
    intervals                   = params.pipelines_testdata_base_path + 'pacbio_data/revio-with-m6a-tags.custom-reference.intervals.bed'

    workflow                    = 'wgs'
    igenomes_ignore             = true

    skip_demultiplexing         = true
    skip_snp                    = true
    sv_caller                   = 'pbsv'
    skip_phase                  = true
    skip_cpg                    = true
    skip_fiberseq               = true
    skip_hificnv                = true
    skip_ensemblvep             = true

}
